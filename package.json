{
  "name": "smartloc",
  "private": true,
  "version": "0.0.0",
  "description": "i18n with tagged template strings, for Node APIs (Express, GraphQL) and React apps",
  "main": "src/index.ts",
  "scripts": {
    "build": "rm -rf bin && bun t && mkdir -p bin && tsc && cp package.release.json bin/package.json && cp README.md AGENTS.md bin && cp -r docs skills bin",
    "release": "bun run build && cd bin && npm publish && cd ..",
    "t": "tsc --project tsconfig.json --noEmit"
  },
  "bin": {
    "smartloc": "src/cli/cli.ts"
  },
  "repository": "https://github.com/oguimbal/smartloc",
  "keywords": [
    "i18n",
    "internationalization",
    "express",
    "apollo",
    "string-templating",
    "tagged-string-template",
    "graphql",
    "translation",
    "typescript",
    "react"
  ],
  "author": "Olivier Guimbal",
  "license": "MIT",
  "dependencies": {
    "accept-language-parser": "~1.5.0",
    "diacritics": "^1.3.0",
    "fast-deep-equal": "^3.1.3",
    "fs-extra": "~8.1.0",
    "gitignore-parser": "^0.0.2",
    "js-levenshtein": "^1.1.6",
    "js-sha1": "^0.7.0",
    "json-stable-stringify": "^1.3.0",
    "xliff": "~4.4.0",
    "yargs": "~15.1.0"
  },
  "peerDependencies": {
    "express": "~4.17.1",
    "graphql": "0.13.2",
    "react": "^19"
  },
  "devDependencies": {
    "@types/gitignore-parser": "^0.0.3",
    "@types/accept-language-parser": "^1.5.1",
    "@types/bun": "latest",
    "@types/diacritics": "^1.3.1",
    "@types/express": "^4.17.2",
    "@types/fs-extra": "^8.0.1",
    "@types/graphql": "0.13.2",
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^13.1.8",
    "@types/react": "^19.2.7",
    "@types/yargs": "^15.0.0",
    "typescript": "^5.9.3"
  }
}
